# ===========================
# Aplicación
# ===========================
APP_NAME=Reserva Laboratorios
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Puerto publicado por nginx en el host (docker-compose.yml).
# En desarrollo local se deja vacío (usa 80). En un servidor
# compartido, defínelo como una variable de entorno del stack
# para evitar chocar con otros servicios (ej.: APP_PORT=8081).
APP_PORT=80

# ===========================
# Base de datos
# ===========================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reserva_laboratorios
DB_USERNAME=postgres
DB_PASSWORD=postgres123

# ===========================
# PostgreSQL
# ===========================
POSTGRES_DB=reserva_laboratorios
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ===========================
# pgAdmin
# ===========================
PGADMIN_DEFAULT_EMAIL=admin@reserva.local
PGADMIN_DEFAULT_PASSWORD=admin123

# ===========================
# Correo (SMTP)
# ===========================
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="ReservaLab"