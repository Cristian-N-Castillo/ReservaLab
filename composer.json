{
    "name": "cristian-n-castillo/reservalab",
    "description": "Sistema de Reserva de Laboratorios para establecimientos educacionales.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Cristian N. Castillo"
        }
    ],
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/",
            "Core\\": "src/Core/",
            "Database\\": "src/database/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}